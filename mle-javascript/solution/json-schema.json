{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/image-exif.schema.json",
  "title": "Image EXIF Metadata",
  "description": "Selected EXIF metadata extracted from an image.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ColorSpace": {
      "type": "integer",
      "minimum": 0
    },
    "GPSDateStamp": {
      "type": "string",
      "pattern": "^\\d{4}:\\d{2}:\\d{2}$",
      "examples": [
        "2025:09:05"
      ]
    },
    "ISO": {
      "type": "integer",
      "minimum": 0
    },
    "OffsetTimeDigitized": {
      "type": "string",
      "pattern": "^[+-](?:0\\d|1\\d|2[0-3]):[0-5]\\d$",
      "examples": [
        "+02:00"
      ]
    },
    "LensModel": {
      "type": "string",
      "minLength": 1
    },
    "latitude": {
      "type": "number",
      "minimum": -90,
      "maximum": 90
    },
    "longitude": {
      "type": "number",
      "minimum": -180,
      "maximum": 180
    },
    "LensMake": {
      "type": "string",
      "minLength": 1
    },
    "ExposureProgram": {
      "type": "string",
      "minLength": 1
    },
    "GPSAltitude": {
      "type": "number"
    },
    "SceneType": {
      "type": "string",
      "minLength": 1
    },
    "ModifyDate": {
      "type": "string",
      "format": "date-time"
    },
    "CreateDate": {
      "type": "string",
      "format": "date-time"
    },
    "ExifVersion": {
      "type": "string",
      "pattern": "^\\d+(?:\\.\\d+)*$",
      "examples": [
        "2.3.2"
      ]
    },
    "ExposureMode": {
      "type": "string",
      "minLength": 1
    },
    "Software": {
      "type": "string",
      "minLength": 1
    },
    "Orientation": {
      "type": "string",
      "minLength": 1
    },
    "ExifImageHeight": {
      "type": "integer",
      "minimum": 1
    },
    "Make": {
      "type": "string",
      "minLength": 1
    },
    "ExifImageWidth": {
      "type": "integer",
      "minimum": 1
    },
    "HostComputer": {
      "type": "string",
      "minLength": 1
    },
    "Model": {
      "type": "string",
      "minLength": 1
    },
    "DateTimeOriginal": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": [
    "ColorSpace",
    "GPSDateStamp",
    "ISO",
    "OffsetTimeDigitized",
    "LensModel",
    "latitude",
    "longitude",
    "LensMake",
    "ExposureProgram",
    "GPSAltitude",
    "SceneType",
    "ModifyDate",
    "CreateDate",
    "ExifVersion",
    "ExposureMode",
    "Software",
    "Orientation",
    "ExifImageHeight",
    "Make",
    "ExifImageWidth",
    "HostComputer",
    "Model",
    "DateTimeOriginal"
  ]
}