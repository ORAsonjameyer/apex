{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/image-exif.schema.json",
  "title": "Image EXIF Metadata",
  "description": "Selected EXIF metadata extracted from an image.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "ColorSpace": {
      "type": "string"
    },
    "GPSDateStamp": {
      "type": "string"
    },
    "ISO": {
      "type": "string"
    },
    "OffsetTimeDigitized": {
      "type": "string"
    },
    "LensModel": {
      "type": "string"
    },
    "latitude": {
      "type": "string"
    },
    "longitude": {
      "type": "string"
    },
    "LensMake": {
      "type": "string"
    },
    "ExposureProgram": {
      "type": "string"
    },
    "GPSAltitude": {
      "type": "string"
    },
    "SceneType": {
      "type": "string"
    },
    "ModifyDate": {
      "type": "string"
    },
    "CreateDate": {
      "type": "string"
    },
    "ExifVersion": {
      "type": "string"
    },
    "ExposureMode": {
      "type": "string"
    },
    "Software": {
      "type": "string"
    },
    "Orientation": {
      "type": "string"
    },
    "ExifImageHeight": {
      "type": "integer"
    },
    "Make": {
      "type": "string"
    },
    "ExifImageWidth": {
      "type": "string"
    },
    "HostComputer": {
      "type": "string"
    },
    "Model": {
      "type": "string"
    },
    "DateTimeOriginal": {
      "type": "string"
    }
  },
  "required": [
    "ColorSpace",
    "GPSDateStamp",
    "ISO",
    "OffsetTimeDigitized",
    "LensModel",
    "latitude",
    "longitude",
    "LensMake",
    "ExposureProgram",
    "GPSAltitude",
    "SceneType",
    "ModifyDate",
    "CreateDate",
    "ExifVersion",
    "ExposureMode",
    "Software",
    "Orientation",
    "ExifImageHeight",
    "Make",
    "ExifImageWidth",
    "HostComputer",
    "Model",
    "DateTimeOriginal"
  ]
}